    {
      "type": "code",
      "content": "currentValue = 2"
    },
    {
      "type": "text",
      "content": "1 + 2"
    },
    {
      "type": "text",
      "content": "Получаем:"
    },
    {
      "type": "text",
      "content": "3"
    },
    {
      "type": "text",
      "content": "Теперь:"
